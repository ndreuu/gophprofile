APP_MODE=production
HTTP_ADDR=:8080
DATABASE_URL=postgres://gophprofile:gophprofile_dev@localhost:5432/gophprofile?sslmode=disable
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=avatar-events
KAFKA_GROUP_ID=avatar-workers
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=gophprofile
S3_SECRET_KEY=gophprofile_dev_secret
S3_BUCKET=avatars
S3_USE_SSL=false
SHUTDOWN_TIMEOUT=10s
OUTBOX_POLL_INTERVAL=250ms
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY=500ms
WORKER_RETRY_MAX_DELAY=10s
POSTGRES_PASSWORD=gophprofile_dev
MINIO_ROOT_USER=gophprofile
MINIO_ROOT_PASSWORD=gophprofile_dev_secret

CORS_ALLOWED_ORIGINS=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
